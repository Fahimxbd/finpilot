# FinPilot defaults to free/local services only.
FINPILOT_LIMITS_FILE=config/limits.yaml
FINPILOT_USAGE_FILE=.finpilot/usage.json
FINPILOT_AUDIT_FILE=.finpilot/ai_audit.jsonl

# Hard overrides. Leave blank to use limits.yaml.
MAX_MONTHLY_API_CALLS=
MAX_TOKENS_PER_RUN=

# Optional local Ollama integration (no cloud bill).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120
FINPILOT_ENABLE_LLM=false

# For sensitive financial documents, full prompt/response logging is OFF by default.
# Metadata, hashes, token estimates, and statuses are still logged.
FINPILOT_LOG_FULL_AI_CONTENT=false
